# ==============================================================================
# KITTY CORP Demo Studio — Environment Configuration
# ==============================================================================

# Admin Session & Authentication (Server-side HMAC gateway)
# ADMIN_USERNAME: Chosen admin identifier
# ADMIN_PASSWORD: Minimum 12 characters recommended for production
# SESSION_SECRET: Minimum 32 cryptographically random characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-unique-secure-password
SESSION_SECRET=replace-with-at-least-32-random-characters-secret

# Application Origin URL
# Development: http://localhost:3000
# Production: https://demo.thekittycorp.com
APP_URL=http://localhost:3000

# Persistence Provider
# Options:
#   local     - Uses file-based JSON store in DATA_DIR (.data/database.json)
#   supabase  - Uses Supabase PostgreSQL & Storage via server-side REST adapter
DATA_PROVIDER=local
DATA_DIR=.data

# Supabase Production Configuration (Required when DATA_PROVIDER=supabase)
# NOTE: Never prefix SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_
SUPABASE_URL=https://yjmnmwnljzvvclvipkxy.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-service-role-key

# Optional client-side Supabase publishable variables (if using public client features)
# NEXT_PUBLIC_SUPABASE_URL=https://yjmnmwnljzvvclvipkxy.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key
